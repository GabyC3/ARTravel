{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port={Portal};Database={BD};Username={Name};Password={tuContraseña}"
  },
  "Jwt": {
    "Issuer": "ARTravel",
    "Audience": "ARTravel.Client",
    "SigningKey": "{JWT_TOKEN}",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "PasswordResetMinutes": 30
  }
}